# ==============================================================================
# TechnoFunda Swing Bot - Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (for backend script / GitHub Action full write access)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Anon Public Key (used by frontend browser)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Optional: Screener.in session cookie for private screens (if your custom screen is not made public)
SCREENER_SESSION_ID=
